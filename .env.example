# Kazi Gift and Print House — environment variables
# Copy to .env and fill in real values. NEVER commit a real .env file.
# Use the Neon pooled connection string for DATABASE_URL (host contains -pooler).

# Neon Postgres pooled connection string, e.g.:
# postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require

# Initial admin password used by the seed script. Must be set; the seed fails
# without it. Use a long generated password (16+ characters).
ADMIN_PASSWORD=change-me-to-a-long-generated-password

# Secret used to sign admin and customer session JWTs. Must be set; the app
# fails to boot if it is missing or shorter than 32 characters. Use a long
# random string (32+ characters) and never reuse it across environments.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Public base URL of the deployed site, e.g. https://print-house-client.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
