# PostgreSQL connection string (Neon / Supabase / any Postgres).
# Example: postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/kazi_gift_print_house?schema=public"

# Admin account created by the seed script. CHANGE THIS before going live.
ADMIN_PASSWORD="Admin@1234"

# Secret used to sign admin session JWTs. Use a long random string.
JWT_SECRET="change-me-to-a-long-random-secret"

# Public base URL of the deployed site (used for metadata links).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
